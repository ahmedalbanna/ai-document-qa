            },
            "models": {
                "qwen2.5-coder:32b": {
                    "name": "Qwen 2.5 Coder 32B"
                },
                "llama2": {
                    "name": "Llama 2"
                },
                "aya": {
                    "name": "Aya (multilingual)"
                }
            }
        }
    },
    "model": "ollama/qwen2.5-coder:32b"
}